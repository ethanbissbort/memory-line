<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A self-hosted sync service is commonly reached over plain HTTP on a LAN
	     or a private hostname, so arbitrary loads are permitted exactly as the
	     iOS companion permits them. Revisit if the service ever gains a
	     public TLS-only deployment story. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Shared with the iOS companion so a memoryline:// link opens whichever
	     app the user is in front of. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ca.fluxology.memoryline.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>memoryline</string>
			</array>
		</dict>
	</array>

	<!-- Closing the last window should not quit: the Mac app keeps syncing. -->
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
