<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform-neutral on purpose: Core holds the business logic and must
         stay buildable off Windows so the same services can back a non-WinUI
         head (see docs/design/MACOS-PORT-PLAN.md). Nothing here may reference
         WinUI/WinRT types - presentation concerns belong in the UI project. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- HTTP Client for API calls -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />

    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />

    <!-- Resilience and retry logic -->
    <PackageReference Include="Polly" Version="8.2.0" />

    <!-- Anthropic SDK (unofficial but well-maintained) -->
    <PackageReference Include="Anthropic.SDK" Version="5.8.0" />

    <!-- EXIF/metadata reading for media attachments (MIT, no native deps) -->
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />

    <!-- ONNX Runtime for the local embedding model. The cross-platform package,
         not .DirectML: OnnxEmbeddingService deliberately uses default (CPU)
         session options, so the DirectML EP was never registered. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.16.3" />

    <!-- MVVM Toolkit for commands and observables -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MemoryTimeline.Data\MemoryTimeline.Data.csproj" />
  </ItemGroup>

</Project>
