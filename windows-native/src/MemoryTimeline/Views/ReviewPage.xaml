<Page
    x:Class="MemoryTimeline.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:MemoryTimeline.Core.DTOs"
    xmlns:viewmodels="using:MemoryTimeline.ViewModels"
    xmlns:views="using:MemoryTimeline.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Maps a pending event id to its cached per-card suggestions state
             (the page assigns the ViewModel after InitializeComponent). -->
        <views:ReviewSuggestionsStateConverter x:Key="ReviewSuggestionsStateConverter"/>

        <!-- Content of one card's "People suggestions" expander -->
        <DataTemplate x:Key="PersonSuggestionsStateTemplate" x:DataType="viewmodels:PersonSuggestionsState">
            <StackPanel Spacing="8">
                <InfoBar Severity="Error"
                         Title="People suggestions"
                         IsOpen="{x:Bind IsErrorOpen, Mode=TwoWay}"
                         Message="{x:Bind ErrorMessage, Mode=OneWay}"/>

                <!-- Loading indicator (first expand fetches suggestions lazily) -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                           Visibility="{x:Bind IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="20" Height="20"/>
                    <TextBlock Text="Loading suggestions..."
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Text="No people suggestions for this event."
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>

                <Button HorizontalAlignment="Right"
                       Command="{x:Bind ApplyAllCommand}"
                       IsEnabled="{x:Bind HasApplicableSuggestions, Mode=OneWay}"
                       Visibility="{x:Bind HasSuggestions, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14"/>
                        <TextBlock Text="Apply all"/>
                    </StackPanel>
                </Button>

                <ItemsControl ItemsSource="{x:Bind Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dtos:PersonSuggestionDto">
                            <Grid Padding="8"
                                 Margin="0,2"
                                 ColumnSpacing="12"
                                 CornerRadius="4"
                                 Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                         Glyph="{x:Bind KindGlyph, Mode=OneWay}"
                                         FontSize="16"
                                         VerticalAlignment="Center"
                                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                  FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind KindDisplay, Mode=OneWay}"
                                                  Style="{StaticResource CaptionTextBlockStyle}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                                              Style="{StaticResource CaptionTextBlockStyle}"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                       Content="Apply"
                                       VerticalAlignment="Center"
                                       IsEnabled="{x:Bind CanApply, Mode=OneWay}"
                                       Visibility="{x:Bind IsApplied, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}"
                                       Click="OnApplySuggestionClick"/>

                                <StackPanel Grid.Column="2"
                                           Orientation="Horizontal"
                                           Spacing="4"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsApplied, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE73E;"
                                             FontSize="14"
                                             Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock Text="Applied"
                                              Style="{StaticResource CaptionTextBlockStyle}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Pivot Grid.Row="0">
            <!-- ============ Pending Events tab ============ -->
            <PivotItem Header="{x:Bind ViewModel.PendingPivotHeader, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="24,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Review Extracted Events"
                                      Style="{StaticResource TitleTextBlockStyle}"/>
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}"/>
                                <Run Text="pending events awaiting review"/>
                            </TextBlock>
                        </StackPanel>

                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                            <AppBarButton Icon="Refresh"
                                         Label="Refresh"
                                         Command="{x:Bind ViewModel.RefreshPendingEventsCommand}"/>

                            <AppBarButton Icon="Accept"
                                         Label="Approve All"
                                         Command="{x:Bind ViewModel.ApproveAllCommand}"
                                         IsEnabled="{x:Bind ViewModel.HasPendingEvents, Mode=OneWay}"/>

                            <AppBarButton Icon="Cancel"
                                         Label="Reject All"
                                         Command="{x:Bind ViewModel.RejectAllCommand}"
                                         IsEnabled="{x:Bind ViewModel.HasPendingEvents, Mode=OneWay}"/>
                        </CommandBar>
                    </Grid>

                    <!-- Main Content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Loading Overlay -->
                        <Grid Grid.Column="0" Grid.ColumnSpan="2"
                              Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                              Background="#80000000"
                              Canvas.ZIndex="1000">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <ProgressRing IsActive="True" Width="48" Height="48"/>
                                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                          FontSize="16"
                                          Foreground="White"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Empty State -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2"
                                   Spacing="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <FontIcon Glyph="&#xE73E;"
                                     FontSize="64"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="No pending events"
                                      Style="{StaticResource SubtitleTextBlockStyle}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Events extracted from recordings will appear here for review"
                                      Style="{StaticResource BodyTextBlockStyle}"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"
                                      MaxWidth="400"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Event List -->
                        <ScrollViewer Grid.Column="0"
                                     Visibility="{x:Bind ViewModel.HasPendingEvents, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <StackPanel Padding="24" Spacing="12">
                                <ListView ItemsSource="{x:Bind ViewModel.PendingEvents, Mode=OneWay}"
                                         SelectedItem="{x:Bind ViewModel.SelectedEvent, Mode=TwoWay}"
                                         SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:PendingEventDto">
                                            <Grid Padding="16"
                                                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                 BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                 BorderThickness="1"
                                                 CornerRadius="8"
                                                 Margin="0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header with Title and Confidence -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon Grid.Column="0"
                                                             Glyph="{x:Bind CategoryIcon, Mode=OneWay}"
                                                             FontSize="24"
                                                             Margin="0,0,12,0"
                                                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                                                  TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind Category, Mode=OneWay}"
                                                                  Style="{StaticResource CaptionTextBlockStyle}"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <TextBlock Text="{x:Bind ConfidenceDisplay, Mode=OneWay}"
                                                                  FontWeight="SemiBold"
                                                                  Foreground="{x:Bind ConfidenceColorHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                                  HorizontalAlignment="Right"/>
                                                        <TextBlock Text="Confidence"
                                                                  Style="{StaticResource CaptionTextBlockStyle}"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Event Details -->
                                                <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="8">
                                                    <!-- Dates -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE787;" FontSize="16"
                                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{x:Bind StartDateDisplay, Mode=OneWay}"/>
                                                            <TextBlock Text="→"
                                                                      Visibility="{x:Bind HasEndDate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                                            <TextBlock Text="{x:Bind EndDateDisplay, Mode=OneWay}"
                                                                      Visibility="{x:Bind HasEndDate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind DurationDisplay, Mode=OneWay}"
                                                                  Style="{StaticResource CaptionTextBlockStyle}"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        <!-- Date precision Claude assigned (correctable via Edit) -->
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                               CornerRadius="8"
                                                               Padding="8,2"
                                                               VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind DatePrecisionDisplay, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind DatePrecisionLabel, Mode=OneWay}"
                                                                      Style="{StaticResource CaptionTextBlockStyle}"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Description -->
                                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                                              TextWrapping="Wrap"
                                                              MaxLines="3"
                                                              TextTrimming="CharacterEllipsis"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                                    <!-- Source Transcript (shown when the recording pipeline persisted one) -->
                                                    <StackPanel Spacing="4"
                                                               Visibility="{x:Bind HasTranscript, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE720;" FontSize="14"
                                                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            <TextBlock Text="Transcript"
                                                                      Style="{StaticResource CaptionTextBlockStyle}"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Transcript, Mode=OneWay}"
                                                                  TextWrapping="Wrap"
                                                                  MaxLines="4"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  FontStyle="Italic"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- People chips (extracted person names) -->
                                                    <ItemsControl ItemsSource="{x:Bind PeopleNames}"
                                                                 Visibility="{x:Bind HasPeople, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                       CornerRadius="12"
                                                                       Padding="10,4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE77B;"
                                                                                 FontSize="12"
                                                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                        <TextBlock Text="{x:Bind}"
                                                                                  Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Person suggestions (lazily loaded on first expand) -->
                                                    <Expander HorizontalAlignment="Stretch"
                                                             HorizontalContentAlignment="Stretch"
                                                             Visibility="{x:Bind HasPeople, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             Expanding="OnPeopleSuggestionsExpanding">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE716;" FontSize="14"/>
                                                                <TextBlock Text="People suggestions"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ContentControl HorizontalAlignment="Stretch"
                                                                       HorizontalContentAlignment="Stretch"
                                                                       Content="{x:Bind PendingEventId, Converter={StaticResource ReviewSuggestionsStateConverter}}"
                                                                       ContentTemplate="{StaticResource PersonSuggestionsStateTemplate}"/>
                                                    </Expander>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                                    <Button Command="{x:Bind ApproveCommand, Mode=OneWay}"
                                                           Style="{StaticResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                                            <TextBlock Text="Approve"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{x:Bind EditCommand, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                                                            <TextBlock Text="Edit"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{x:Bind RejectCommand, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE711;" FontSize="16"/>
                                                            <TextBlock Text="Reject"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>

                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Edit Panel (opens via the Edit button on a pending event) -->
                        <Border Grid.Column="1"
                               Width="360"
                               Margin="0,24,24,24"
                               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               BorderThickness="1"
                               CornerRadius="8"
                               VerticalAlignment="Top"
                               Visibility="{x:Bind ViewModel.IsEditing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <ScrollViewer>
                                <StackPanel Padding="16" Spacing="12">
                                    <TextBlock Text="Edit Event"
                                              Style="{StaticResource SubtitleTextBlockStyle}"/>

                                    <TextBox Header="Title"
                                            Text="{x:Bind ViewModel.SelectedEvent.Title, Mode=TwoWay}"/>

                                    <CalendarDatePicker Header="Start date"
                                                       PlaceholderText="Select date"
                                                       Date="{x:Bind ViewModel.SelectedEvent.StartDateOffset, Mode=TwoWay}"
                                                       HorizontalAlignment="Stretch"/>

                                    <CalendarDatePicker Header="End date (optional)"
                                                       PlaceholderText="Select date"
                                                       Date="{x:Bind ViewModel.SelectedEvent.EndDateOffset, Mode=TwoWay}"
                                                       HorizontalAlignment="Stretch"/>

                                    <!-- How much of the start date to believe; same lowercase
                                         tag pattern as the category combo below. -->
                                    <ComboBox Header="Date precision"
                                             PlaceholderText="Select precision"
                                             SelectedValuePath="Tag"
                                             SelectedValue="{x:Bind ViewModel.SelectedEvent.DatePrecisionValue, Mode=TwoWay}"
                                             HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Exact time" Tag="exact"/>
                                        <ComboBoxItem Content="Day" Tag="day"/>
                                        <ComboBoxItem Content="Month" Tag="month"/>
                                        <ComboBoxItem Content="Season" Tag="season"/>
                                        <ComboBoxItem Content="Year" Tag="year"/>
                                        <ComboBoxItem Content="Decade" Tag="decade"/>
                                        <ComboBoxItem Content="Unknown" Tag="unknown"/>
                                    </ComboBox>

                                    <!-- Live precision-honest preview ("Summer 1998") -->
                                    <TextBlock Text="{x:Bind ViewModel.SelectedEvent.DatePrecisionDisplay, Mode=OneWay}"
                                              Style="{StaticResource CaptionTextBlockStyle}"
                                              FontStyle="Italic"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <TextBox Header="Description"
                                            Text="{x:Bind ViewModel.SelectedEvent.Description, Mode=TwoWay, TargetNullValue=''}"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            Height="100"/>

                                    <!-- Same lowercase category tags as the timeline Add Event dialog -->
                                    <ComboBox Header="Category"
                                             PlaceholderText="Select category"
                                             SelectedValuePath="Tag"
                                             SelectedValue="{x:Bind ViewModel.SelectedEvent.Category, Mode=TwoWay}"
                                             HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Milestone" Tag="milestone"/>
                                        <ComboBoxItem Content="Work" Tag="work"/>
                                        <ComboBoxItem Content="Education" Tag="education"/>
                                        <ComboBoxItem Content="Relationship" Tag="relationship"/>
                                        <ComboBoxItem Content="Travel" Tag="travel"/>
                                        <ComboBoxItem Content="Achievement" Tag="achievement"/>
                                        <ComboBoxItem Content="Challenge" Tag="challenge"/>
                                        <ComboBoxItem Content="Era" Tag="era"/>
                                        <ComboBoxItem Content="Other" Tag="other"/>
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Button Command="{x:Bind ViewModel.SaveChangesCommand}"
                                               Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                                <TextBlock Text="Save"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{x:Bind ViewModel.CancelEditCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE711;" FontSize="16"/>
                                                <TextBlock Text="Cancel"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- ============ Drafts tab ============ -->
            <PivotItem Header="{x:Bind ViewModel.DraftsPivotHeader, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drafts header -->
                    <Grid Grid.Row="0" Padding="24,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Drafts"
                                      Style="{StaticResource TitleTextBlockStyle}"/>
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind ViewModel.DraftCount, Mode=OneWay}"/>
                                <Run Text="saved drafts to resume"/>
                            </TextBlock>
                        </StackPanel>

                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                            <AppBarButton Icon="Refresh"
                                         Label="Refresh"
                                         Command="{x:Bind ViewModel.RefreshDraftsCommand}"/>
                        </CommandBar>
                    </Grid>

                    <InfoBar Grid.Row="1"
                            Margin="24,8,24,0"
                            Severity="Error"
                            Title="Drafts"
                            IsOpen="{x:Bind ViewModel.IsDraftsErrorOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.DraftsErrorMessage, Mode=OneWay}"/>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="2"
                               Spacing="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.IsDraftsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon Glyph="&#xE70B;"
                                 FontSize="64"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="No drafts"
                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Save an event, era, or person as a draft to finish it later"
                                  Style="{StaticResource BodyTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  TextWrapping="Wrap"
                                  TextAlignment="Center"
                                  MaxWidth="400"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Drafts list -->
                    <ListView Grid.Row="2"
                             Padding="24,12"
                             SelectionMode="None"
                             ItemsSource="{x:Bind ViewModel.Drafts, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasDrafts, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:DraftDto">
                                <Grid Padding="16"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     Margin="0,4"
                                     ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                             Glyph="{x:Bind TypeGlyph, Mode=OneWay}"
                                             FontSize="24"
                                             VerticalAlignment="Center"
                                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                                  TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind TypeDisplay, Mode=OneWay}"
                                                      Style="{StaticResource CaptionTextBlockStyle}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="•"
                                                      Style="{StaticResource CaptionTextBlockStyle}"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind UpdatedDisplay, Mode=OneWay}"
                                                      Style="{StaticResource CaptionTextBlockStyle}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                               Click="OnResumeDraftClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                                                <TextBlock Text="Resume"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Click="OnDeleteDraftClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                                <TextBlock Text="Delete"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Status Bar -->
        <Grid Grid.Row="1"
              Padding="24,12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                      Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                      VerticalAlignment="Center"
                      Style="{StaticResource BodyTextBlockStyle}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE81C;" FontSize="16"
                             Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                    <TextBlock>
                        <Run Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}"/>
                        <Run Text="Pending"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="16"
                             Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock>
                        <Run Text="{x:Bind ViewModel.ApprovedCount, Mode=OneWay}"/>
                        <Run Text="Approved"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
