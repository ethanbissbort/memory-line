<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MemoryTimeline.Views.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MemoryTimeline.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + message surfaces -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Map"
                      Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.LocatedSummary, Mode=OneWay}"
                      Style="{StaticResource BodyTextBlockStyle}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}"
                    Severity="Error"
                    Title="Something went wrong"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Closed="ErrorBar_Closed"/>

            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}"
                    Severity="Informational"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Closed="StatusBar_Closed"/>

            <!-- Pin-drop instruction bar -->
            <Grid Visibility="{x:Bind ViewModel.IsPinDropMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                 BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                 BorderThickness="1"
                 CornerRadius="8"
                 Padding="12"
                 ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE707;" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                          Text="{x:Bind ViewModel.PinDropPrompt, Mode=OneWay}"
                          VerticalAlignment="Center"
                          TextWrapping="Wrap"/>
                <Button Grid.Column="2"
                       Content="Cancel"
                       VerticalAlignment="Center"
                       Command="{x:Bind ViewModel.CancelPinDropCommand}"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- The offline map surface. DEFERRED (F10): an optional raster
                 tile basemap (offline MBTiles/pre-downloaded tile cache) could
                 render beneath the graticule here; skipped for now to keep the
                 app fully local-first with zero map-network dependencies -
                 the equirectangular graticule + pins carry the feature. -->
            <Border Grid.Column="0"
                   CornerRadius="8"
                   Background="#FF0E141B"
                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                   BorderThickness="1">
                <Grid x:Name="MapHost"
                     Background="Transparent"
                     SizeChanged="MapHost_SizeChanged"
                     PointerPressed="MapHost_PointerPressed"
                     PointerMoved="MapHost_PointerMoved"
                     PointerReleased="MapHost_PointerReleased"
                     PointerCanceled="MapHost_PointerCanceled"
                     PointerCaptureLost="MapHost_PointerCaptureLost"
                     PointerWheelChanged="MapHost_PointerWheelChanged"
                     Tapped="MapHost_Tapped">

                    <!-- Subtle 30-degree graticule, redrawn from code-behind on pan/zoom/resize -->
                    <Canvas x:Name="GraticuleCanvas" IsHitTestVisible="False"/>

                    <!-- Travel path (points set from code-behind when the animation builds) -->
                    <Polyline x:Name="TravelPolyline"
                             IsHitTestVisible="False"
                             Stroke="#FF80CBC4"
                             StrokeThickness="2"
                             StrokeDashArray="4 3"
                             Opacity="0.9"/>

                    <!-- Location pins / cluster badges (TimelineControl's
                         ItemsControl + Canvas + TranslateTransform pattern) -->
                    <ItemsControl x:Name="PinsLayer"
                                 ItemsSource="{x:Bind ViewModel.DisplayPins, Mode=OneWay}"
                                 IsHitTestVisible="{x:Bind ViewModel.IsPinInteractionEnabled, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:MapDisplayPin">
                                <Grid>
                                    <Grid.RenderTransform>
                                        <TranslateTransform X="{x:Bind X, Mode=OneWay}" Y="{x:Bind Y, Mode=OneWay}"/>
                                    </Grid.RenderTransform>

                                    <!-- Single place: click opens the details flyout -->
                                    <Button Padding="0"
                                           BorderThickness="0"
                                           Background="Transparent"
                                           Visibility="{x:Bind IsCluster, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                           ToolTipService.ToolTip="{x:Bind Label}">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8" MinWidth="240" MaxWidth="320">
                                                    <TextBlock Text="{x:Bind Label}"
                                                              Style="{StaticResource BodyStrongTextBlockStyle}"
                                                              TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind EventCountText}"
                                                              Style="{StaticResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <ItemsControl ItemsSource="{x:Bind Events}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewmodels:MapPinEventItem">
                                                                <Button Command="{x:Bind OpenCommand}"
                                                                       HorizontalAlignment="Stretch"
                                                                       HorizontalContentAlignment="Stretch"
                                                                       Padding="8"
                                                                       Margin="0,0,0,4">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Text="{x:Bind Title}"
                                                                                  TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{x:Bind DateText}"
                                                                                  Style="{StaticResource CaptionTextBlockStyle}"
                                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="28" Height="28">
                                            <Ellipse Fill="#FF4FC3F7" Stroke="White" StrokeThickness="2"/>
                                            <TextBlock Text="{x:Bind CountText}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      Foreground="#FF0E141B"/>
                                        </Grid>
                                    </Button>

                                    <!-- Cluster badge: click zooms in about the centroid -->
                                    <Button Padding="0"
                                           BorderThickness="0"
                                           Background="Transparent"
                                           Visibility="{x:Bind IsCluster, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Click="ClusterBadge_Click"
                                           ToolTipService.ToolTip="{x:Bind Label}">
                                        <Grid Width="36" Height="36">
                                            <Ellipse Fill="#FFFFB74D" Stroke="White" StrokeThickness="2"/>
                                            <TextBlock Text="{x:Bind CountText}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"
                                                      Foreground="#FF0E141B"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Travel animation marker -->
                    <Ellipse Width="14"
                            Height="14"
                            Fill="#FFFFD54F"
                            Stroke="White"
                            StrokeThickness="2"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind ViewModel.IsTravelMarkerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="{x:Bind ViewModel.TravelMarkerX, Mode=OneWay}"
                                               Y="{x:Bind ViewModel.TravelMarkerY, Mode=OneWay}"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Travel leg caption -->
                    <Border Visibility="{x:Bind ViewModel.TravelStatusText, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="12"
                           Background="#CC1B2530"
                           CornerRadius="6"
                           Padding="10,6">
                        <TextBlock Text="{x:Bind ViewModel.TravelStatusText, Mode=OneWay}"
                                  Foreground="#FFECEFF1"
                                  Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Border>

                    <!-- Empty state: how coordinates arrive -->
                    <StackPanel MaxWidth="400"
                               Spacing="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.ShowMapEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE707;"
                                 FontSize="44"
                                 Foreground="#FF78909C"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="No places on the map yet"
                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                  Foreground="#FFCFD8DC"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Foreground="#FFB0BEC5"
                                  TextWrapping="Wrap"
                                  TextAlignment="Center"
                                  Text="Coordinates can arrive three ways: attach a photo with GPS data to an event, pick a place under 'Unlocated places' and click 'Set location' to drop a pin, or turn on online geocoding and use 'Look up'."/>
                    </StackPanel>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Width="44"
                                 Height="44"/>
                </Grid>
            </Border>

            <!-- Side panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- Year-range scrubber (two sliders = a range selector) -->
                    <StackPanel Spacing="8"
                               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="16">
                        <TextBlock Text="Time range"
                                  Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.YearRangeText, Mode=OneWay}"
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider Header="From"
                               Minimum="{x:Bind ViewModel.DataMinYear, Mode=OneWay}"
                               Maximum="{x:Bind ViewModel.DataMaxYear, Mode=OneWay}"
                               Value="{x:Bind ViewModel.YearRangeStart, Mode=TwoWay}"
                               StepFrequency="1"/>
                        <Slider Header="To"
                               Minimum="{x:Bind ViewModel.DataMinYear, Mode=OneWay}"
                               Maximum="{x:Bind ViewModel.DataMaxYear, Mode=OneWay}"
                               Value="{x:Bind ViewModel.YearRangeEnd, Mode=TwoWay}"
                               StepFrequency="1"/>
                    </StackPanel>

                    <!-- Travel animation -->
                    <StackPanel Spacing="8"
                               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="16">
                        <TextBlock Text="Travel animation"
                                  Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Replay a year's located events as a journey across the map."
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="TravelYearCombo"
                                     MinWidth="110"
                                     PlaceholderText="Year"
                                     ItemsSource="{x:Bind ViewModel.TravelYears, Mode=OneWay}"
                                     SelectionChanged="TravelYearCombo_SelectionChanged"/>
                            <Button Content="Play"
                                   Style="{StaticResource AccentButtonStyle}"
                                   Command="{x:Bind ViewModel.PlayTravelCommand}"/>
                            <Button Content="Stop"
                                   Command="{x:Bind ViewModel.StopTravelCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Unlocated places manager -->
                    <StackPanel Spacing="8"
                               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="16">
                        <TextBlock Text="Unlocated places"
                                  Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="These places have no coordinates yet, so they cannot appear on the map."
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Visibility="{x:Bind ViewModel.HasUnlocated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="Every place already has coordinates."
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind ViewModel.HasUnlocated, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        <Button Content="Geocode all missing…"
                               Command="{x:Bind ViewModel.GeocodeAllMissingCommand}"/>
                        <StackPanel Orientation="Horizontal"
                                   Spacing="8"
                                   Visibility="{x:Bind ViewModel.IsGeocodingBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsGeocodingBusy, Mode=OneWay}"
                                         Width="16"
                                         Height="16"/>
                            <TextBlock Text="{x:Bind ViewModel.GeocodeProgressText, Mode=OneWay}"
                                      Style="{StaticResource CaptionTextBlockStyle}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.UnlocatedPlaces, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:UnlocatedPlaceItem">
                                    <Grid ColumnSpacing="8" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}"
                                                      TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind EventCountText}"
                                                      Style="{StaticResource CaptionTextBlockStyle}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                               Content="Set location"
                                               VerticalAlignment="Center"
                                               Command="{x:Bind SetLocationCommand}"/>
                                        <Button Grid.Column="2"
                                               Content="Look up"
                                               VerticalAlignment="Center"
                                               Command="{x:Bind LookUpCommand}"
                                               Visibility="{x:Bind CanLookUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Geocoding privacy (lives HERE, not on the Settings page) -->
                    <StackPanel Spacing="8"
                               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               BorderThickness="1"
                               CornerRadius="8"
                               Padding="16">
                        <TextBlock Text="Online geocoding"
                                  Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <ToggleSwitch Header="Look up coordinates online"
                                     IsOn="{x:Bind ViewModel.IsGeocodingEnabled, Mode=TwoWay}"
                                     OnContent="On"
                                     OffContent="Off"/>
                        <TextBlock Text="Sends place names to OpenStreetMap Nominatim. Off by default."
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.GeocodingProviderText, Mode=OneWay}"
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
