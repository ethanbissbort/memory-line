<ContentDialog
    x:Class="MemoryTimeline.Controls.NarrativeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:MemoryTimeline.Core.Services"
    mc:Ignorable="d"
    Title="Generate story"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
        <StackPanel Spacing="12" MinWidth="480" Margin="0,0,12,0">

            <!-- In-dialog error surface (missing API key, LLM/export failures). -->
            <InfoBar x:Name="NarrativeErrorBar"
                    Severity="Error"
                    Title="Story generation failed"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}"
                    IsClosable="True"
                    Closed="NarrativeErrorBar_Closed"/>

            <TextBlock TextWrapping="Wrap">
                <Run Text="Scope: "/><Run Text="{x:Bind ViewModel.ScopeDisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>

            <!-- Options -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                         Header="Voice"
                         SelectedIndex="{x:Bind ViewModel.VoiceIndex, Mode=TwoWay}"
                         HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Reflective"/>
                    <ComboBoxItem Content="Factual"/>
                    <ComboBoxItem Content="Warm"/>
                </ComboBox>

                <NumberBox Grid.Column="1"
                          Header="Target words"
                          Value="{x:Bind ViewModel.TargetWords, Mode=TwoWay}"
                          Minimum="150"
                          Maximum="8000"
                          SmallChange="100"
                          SpinButtonPlacementMode="Inline"
                          HorizontalAlignment="Stretch"/>
            </Grid>

            <CheckBox Content="Include citations"
                     IsChecked="{x:Bind ViewModel.IncludeCitations, Mode=TwoWay}"/>

            <!-- Generate / progress -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{x:Bind ViewModel.GenerateButtonText, Mode=OneWay}"
                       Style="{StaticResource AccentButtonStyle}"
                       Command="{x:Bind ViewModel.GenerateCommand}"/>
                <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                             Width="20" Height="20"
                             VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.StageText, Mode=OneWay}"
                          VerticalAlignment="Center"
                          MaxWidth="320"
                          TextTrimming="CharacterEllipsis"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Preview of the generated sections -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                   BorderThickness="1"
                   CornerRadius="4"
                   Visibility="{x:Bind ViewModel.HasNarrative, Mode=OneWay}">
                <ScrollViewer MaxHeight="300" Padding="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.NarrativeTitle, Mode=OneWay}"
                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                  TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:NarrativeSection">
                                    <StackPanel Spacing="4" Margin="0,0,0,12">
                                        <TextBlock Text="{x:Bind Heading}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Prose}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Export -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Export Markdown…"
                       Command="{x:Bind ViewModel.ExportMarkdownCommand}"/>
                <Button Content="Export HTML…"
                       Command="{x:Bind ViewModel.ExportHtmlCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
