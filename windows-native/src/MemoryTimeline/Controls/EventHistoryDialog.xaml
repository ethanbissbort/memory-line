<ContentDialog
    x:Class="MemoryTimeline.Controls.EventHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MemoryTimeline.Controls"
    mc:Ignorable="d"
    PrimaryButtonText="Restore this version"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="12" MinWidth="720" MinHeight="380">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status / confirm / error surface -->
        <InfoBar x:Name="HistoryStatusBar"
                Grid.Row="0"
                IsOpen="False"
                IsClosable="True"/>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Revision list (newest first) -->
            <Grid Grid.Column="0">
                <ListView x:Name="RevisionList"
                         SelectionMode="Single"
                         SelectionChanged="RevisionList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RevisionListItem">
                            <StackPanel Spacing="2" Margin="0,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="14"/>
                                    <TextBlock Text="{x:Bind KindLabel}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind RevisedAtDisplay}"
                                              Style="{StaticResource CaptionTextBlockStyle}"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ChangedFieldsDisplay}"
                                          Style="{StaticResource CaptionTextBlockStyle}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          TextWrapping="Wrap"
                                          Visibility="{x:Bind HasChangedFields, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHistoryText"
                          Text="No history yet — revisions are recorded when this event is created, edited, or restored."
                          TextWrapping="Wrap"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

            <!-- Field-level diff: selected version vs current state -->
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Field" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="This version" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Current" FontWeight="SemiBold"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl x:Name="DiffList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RevisionDiffRow">
                                    <Grid ColumnSpacing="8" Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                  Text="{x:Bind FieldName}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{x:Bind OldValue}"
                                                  TextWrapping="Wrap"
                                                  FontWeight="{x:Bind ValueWeight}"/>
                                        <TextBlock Grid.Column="2"
                                                  Text="{x:Bind CurrentValue}"
                                                  TextWrapping="Wrap"
                                                  FontWeight="{x:Bind ValueWeight}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <TextBlock x:Name="NoSelectionText"
                          Grid.Row="1"
                          Text="Select a version to compare it with the current event."
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
