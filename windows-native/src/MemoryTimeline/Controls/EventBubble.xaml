<UserControl
    x:Class="MemoryTimeline.Controls.EventBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="40"
    d:DesignWidth="30">

    <Grid x:Name="RootGrid"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          Width="30"
          Height="40">

        <!-- Map pin shape. Approximate dates (precision coarser than Month)
             render the whole pin slightly faded as a subtle uncertainty cue. -->
        <Canvas Width="30" Height="40"
                Opacity="{x:Bind PinOpacity, Mode=OneWay}">
            <!-- Pin body (teardrop shape) -->
            <Path x:Name="PinPath"
                  Fill="{x:Bind CategoryBrush, Mode=OneWay}"
                  Stroke="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                  StrokeThickness="1"
                  Data="M15,40 C15,40 0,22 0,14 C0,6.27 6.72,0 15,0 C23.28,0 30,6.27 30,14 C30,22 15,40 15,40 Z">
                <Path.Shadow>
                    <ThemeShadow/>
                </Path.Shadow>
            </Path>

            <!-- Inner circle (white hole) -->
            <Ellipse Canvas.Left="7"
                     Canvas.Top="6"
                     Width="16"
                     Height="16"
                     Fill="White"
                     Opacity="0.9"/>

            <!-- Category icon in center -->
            <FontIcon x:Name="CategoryIcon"
                     Canvas.Left="7"
                     Canvas.Top="6"
                     Width="16"
                     Height="16"
                     Glyph="{x:Bind CategoryGlyph, Mode=OneWay}"
                     FontSize="10"
                     Foreground="{x:Bind CategoryBrush, Mode=OneWay}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Canvas>

        <!-- Photo-count badge: small pill hugging the pin's top-right corner,
             shown only when the event has media attachments. -->
        <Border x:Name="MediaBadge"
               Visibility="{x:Bind MediaBadgeVisibility, Mode=OneWay}"
               Background="{ThemeResource AccentFillColorDefaultBrush}"
               BorderBrush="White"
               BorderThickness="1"
               CornerRadius="7"
               MinWidth="14"
               Height="14"
               Padding="3,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,-4,-4,0">
            <TextBlock Text="{x:Bind MediaBadgeText, Mode=OneWay}"
                      FontSize="9"
                      FontWeight="SemiBold"
                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
