<UserControl
    x:Class="MemoryTimeline.Controls.EventSpanBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="24"
    d:DesignWidth="160">

    <!-- Duration span: rounded bar in the category/era color at reduced
         saturation. The title shows inline once the bar is wide enough; the
         end-cap chevrons appear when the span extends past a viewport edge
         (positioned by code-behind so they hug the VISIBLE edge, not the
         off-screen element edge). -->
    <Grid x:Name="RootGrid"
          Height="24"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited">

        <Border x:Name="BarBorder"
               CornerRadius="12"
               BorderThickness="1"
               Opacity="{x:Bind BarOpacity, Mode=OneWay}"
               Background="{x:Bind BarBrush, Mode=OneWay}"
               BorderBrush="{x:Bind BarBorderBrush, Mode=OneWay}"/>

        <TextBlock x:Name="TitleText"
                  Text="{x:Bind TitleTextValue, Mode=OneWay}"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                  Margin="10,0,10,0"
                  Visibility="{x:Bind TitleVisibility, Mode=OneWay}"
                  IsHitTestVisible="False"/>

        <FontIcon x:Name="LeftClipChevron"
                 Glyph="&#xE76B;"
                 FontSize="10"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"/>

        <FontIcon x:Name="RightClipChevron"
                 Glyph="&#xE76C;"
                 FontSize="10"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"/>
    </Grid>
</UserControl>
